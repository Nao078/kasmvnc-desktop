# Ubuntu 24.04 (noble) 向けビルド設定。
# BASE_IMAGEのdigestは `docker pull ubuntu:24.04 && docker inspect ubuntu:24.04 --format='{{index .RepoDigests 0}}'` で再取得する。
# KASMVNC_SHA256は https://github.com/kasmtech/KasmVNC/releases/tag/v<version> の
# kasmvncserver_<codename>_<version>_amd64.deb を実際にダウンロードして sha256sum で計算した値
# （KasmVNCは公式チェックサムを公開していないため、独立した値との突き合わせはできない）。
DISTRO_FAMILY=ubuntu
BASE_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
KASMVNC_VERSION=1.5.0
KASMVNC_CODENAME=noble
KASMVNC_SHA256=f599fe02e2175b9817b6165f74a5d2bebdc73118dde9181ba3410963bed7ae1e
