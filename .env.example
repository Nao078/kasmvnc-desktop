# ランタイム設定のサンプル。distro固有のビルド設定は distros/*.env を使う。
# 例: docker compose --env-file .env --env-file distros/ubuntu-24.04.env up -d --build

# KasmVNC接続パスワード（必須）
VNC_PASS=changeme

# KasmVNCデスクトップログインユーザー名
VNC_LOGIN_USER=desktop

# 画面解像度・色深度
VNC_GEOMETRY=1920x1080
VNC_DEPTH=24

# ホスト側の公開設定
VNC_BIND_ADDRESS=127.0.0.1
VNC_PORT=8443

# コンテナ内appuserのUID/GID・sudo有効化（既定値のまま推奨。常用時はENABLE_SUDO=falseを推奨）
APP_USER=appuser
APP_UID=1000
APP_GID=1000
ENABLE_SUDO=true

TZ=Asia/Tokyo
